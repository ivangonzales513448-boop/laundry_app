APP_NAME="LabaGo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SEED_TEST_PASSWORD=
APP_URL=http://localhost:8000
FORCE_HTTPS=false
TRUSTED_PROXIES=

# Allowed browser/Capacitor origins (comma separated). Set production values in the host dashboard.
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100,http://localhost,https://localhost,capacitor://localhost
APP_FRONTEND_URL=http://localhost:8100
SANCTUM_TOKEN_EXPIRATION=10080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sudsandfold
DB_USERNAME=root
DB_PASSWORD=

# Legacy SQLite database (kept untouched). Set DB_CONNECTION=sqlite to use it.
# DB_DATABASE=C:/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social sign-in (see docs/SOCIAL_LOGIN_SETUP.md).
# Google: the web client ID is also accepted for browser development.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Facebook: App ID and App Secret from the Facebook Developers dashboard.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
